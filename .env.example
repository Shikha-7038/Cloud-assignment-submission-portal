# Copy this file to .env and fill in real values.
# NEVER commit the real .env file - it is already in .gitignore.

# --- App ---
APP_ENV=local                 # local | production
LOG_LEVEL=INFO

# --- Cloud provider switch ---
# local    = SQLite database + local disk storage (no account needed, free)
# supabase = real cloud Postgres database + Supabase Storage (free tier)
CLOUD_PROVIDER=local

# --- Database ---
# local:    sqlite:///./data/portal.db
# supabase: postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=sqlite:///./data/portal.db

# --- Auth ---
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Anyone registering with role=teacher must supply this code.
# Leave blank to allow open teacher registration (fine for local grading demos).
TEACHER_INVITE_CODE=TEACH-2026

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Local object storage (used when CLOUD_PROVIDER=local) ---
LOCAL_STORAGE_DIR=./data/uploads

# --- Supabase (used when CLOUD_PROVIDER=supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=assignment-submissions
SIGNED_URL_EXPIRE_SECONDS=300

# --- Misc ---
PUBLIC_BASE_URL=http://localhost:8000
AUTH_RATE_LIMIT_PER_MIN=10
